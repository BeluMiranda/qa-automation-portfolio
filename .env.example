# ============================================================
# Environment Variables - QA Automation Portfolio
# Copy this file as .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Sauce Demo (saucedemo.com) ----
SAUCEDEMO_URL=https://www.saucedemo.com
SAUCEDEMO_USER=standard_user
SAUCEDEMO_PASSWORD=secret_sauce
SAUCEDEMO_LOCKED_USER=locked_out_user
SAUCEDEMO_PROBLEM_USER=problem_user
SAUCEDEMO_PERF_USER=performance_glitch_user

# ---- API Base URLs ----
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
DUMMYJSON_URL=https://dummyjson.com

# ---- Browser Config ----
BROWSER=chrome
HEADLESS=true
IMPLICIT_WAIT=10
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=30
SCREENSHOT_ON_FAILURE=true

# ---- Test Config ----
RETRY_COUNT=2
LOG_LEVEL=INFO
